            denoised_np = (denoised_img.cpu().numpy() + 1) / 2
            for c, d in zip(clean_np, denoised_np):
                c = c.squeeze()
                d = d.squeeze()
                test_psnr += psnr(c, d, data_range=1.0)
                test_ssim += ssim(c, d, data_range=1.0)
            img_count += 1

    avg_test_psnr = test_psnr / img_count
